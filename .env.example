# Copy to .env (never commit .env)
# Text model provider: "claude" or "mistral". If unset, whichever key below is set is used.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
FETCHER=mock   # or "browser"
AUDIO_DIR=data/audio
TRANSCRIBER=mock   # or "whisper" (local whisper.cpp) or "voxtral" (Mistral API, needs MISTRAL_API_KEY)
VOXTRAL_MODEL=voxtral-mini-latest
WHISPER_MODEL=models/ggml-large-v3-turbo.bin
